---
import Base from '../../layouts/Base.astro';
import EssayCard from '../../components/EssayCard.astro';
import PageHead from '../../components/PageHead.astro';
import { publishedWriting, nextScheduled, fmtDate } from '../../data/published';
const all = await publishedWriting();
const essays = all.filter(p => p.data.source === 'Essay');
const posts = all.filter(p => p.data.source !== 'Essay');
const [lead, ...rest] = essays;
const upcoming = await nextScheduled();
const topics = [...new Set(essays.map(e => e.data.topic).filter(Boolean))];
---
<Base title="Writing · Mitul Vaghasiya" active="Writing" description="Essays and notes on product research, mobile UX and building apps people keep.">
  <PageHead eyebrow="Writing" title="Notes on research, mobile UX and building what people keep."
    facts={[{ label: 'Essays', value: String(essays.length) }, { label: 'Short posts', value: posts.length ? String(posts.length) : `From ${upcoming ? fmtDate(upcoming.data.date) : 'soon'}` }]}>
    {topics.length > 0 && <p slot="graphic" class="topics">{topics.map(t => <span>{t}</span>)}</p>}
    <p class="lede">Essays you can put to work this week, drawn from my case studies and from shipping mobile apps since 2019. Each ends with one thing to try.</p>
  </PageHead>

  {lead && <section class="wrap lead"><EssayCard p={lead} big /></section>}

  {rest.length > 0 && (
    <section class="wrap">
      <div class="grid">{rest.map(p => <EssayCard p={p} />)}</div>
    </section>
  )}

  <section class="wrap posts-wrap">
    <div class="head"><h2>Short posts</h2><span class="note">First shared on LinkedIn</span></div>
    {posts.length === 0
      ? <p class="empty">The first post goes out on {upcoming ? fmtDate(upcoming.data.date) : 'soon'}. It appears here the same day.</p>
      : <div class="posts">{posts.map(p => (
          <a href={`/writing/${p.id.replace(/^\d{4}-\d\d-\d\d-/, '')}/`}>
            {p.data.cover ? <img src={p.data.cover} alt="" loading="lazy" /> : <span class="ph" />}
            <div><time>{fmtDate(p.data.date)}</time><h3>{p.data.title}</h3></div>
          </a>
        ))}</div>}
  </section>
</Base>

<style>
  .topics { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; }
  .topics span { font-size: 13px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink-2); }
  .lead { padding-bottom: 72px; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 56px 40px; padding-top: 56px; border-top: 1px solid var(--line); }
  .posts-wrap { padding-top: 96px; padding-bottom: 40px; }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); padding-bottom: 16px; margin-bottom: 8px; flex-wrap: wrap; }
  .head h2 { font-size: clamp(26px, 2.4vw, 32px); }
  .note { font-size: 14px; color: var(--ink-3); }
  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 32px; }
  .posts a { display: grid; grid-template-columns: 72px 1fr; gap: 16px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .posts img, .posts .ph { width: 72px; height: 72px; border-radius: 12px; object-fit: cover; background: var(--accent-soft); }
  .posts time { font-size: 13px; color: var(--ink-3); }
  .posts h3 { font-size: 20px; line-height: 1.15; margin-top: 4px; }
  .posts a:hover h3 { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .empty { color: var(--ink-2); padding: 24px 0 40px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .posts { grid-template-columns: 1fr; } }
</style>
