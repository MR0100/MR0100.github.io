---
import Base from '../../layouts/Base.astro';
import { publishedWriting, nextScheduled, fmtDate } from '../../data/published';
const posts = await publishedWriting();
const upcoming = await nextScheduled();
---
<Base title="Writing · Mitul Vaghasiya" active="Writing" description="Notes on product research, mobile UX and building apps people keep.">
  <section class="wrap intro">
    <p class="eyebrow">Writing</p>
    <h1>Notes on research, mobile UX and building what people keep.</h1>
  </section>
  <section class="wrap">
    {posts.length === 0 && <p class="empty">The first article goes out on {upcoming ? fmtDate(upcoming.data.date) : 'soon'}. It will appear here the same day.</p>}
    <ol class="posts">
      {posts.map(p => (
        <li><a href={`/writing/${p.id.replace(/^\d{4}-\d\d-\d\d-/, '')}/`}>
          <time>{fmtDate(p.data.date)}</time>
          <div><h2>{p.data.title}</h2><p>{p.data.dek}</p></div>
        </a></li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .intro { padding-top: 72px; padding-bottom: 40px; }
  .intro h1 { font-size: clamp(40px, 4.8vw, 64px); margin-top: 16px; max-width: 900px; }
  .posts { list-style: none; margin: 0 0 56px; padding: 0; }
  .posts a { display: grid; grid-template-columns: 180px 1fr; gap: 32px; padding: 28px 0; border-top: 1px solid var(--line); }
  .posts li:last-child a { border-bottom: 1px solid var(--line); }
  time { color: var(--ink-3); font-size: 15px; padding-top: 8px; }
  .posts h2 { font-size: clamp(26px, 2.6vw, 34px); }
  .posts p { color: var(--ink-2); margin: 8px 0 0; }
  .posts a:hover h2 { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .empty { color: var(--ink-2); font-size: 19px; padding: 32px 0 72px; border-top: 1px solid var(--line); }
  @media (max-width: 700px) { .posts a { grid-template-columns: 1fr; gap: 6px; } }
</style>
