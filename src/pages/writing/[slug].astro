---
import { render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import Essay from '../../layouts/Essay.astro';
import { publishedWriting, fmtDate } from '../../data/published';
import { profile } from '../../data/profile';
export async function getStaticPaths() {
  return (await publishedWriting()).map(p => ({ params: { slug: p.id.replace(/^\d{4}-\d\d-\d\d-/, '') }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
---
{p.data.source === 'Essay' ? <Essay p={p}><Content /></Essay> : (
<Doc image={p.data.cover || undefined} title={p.data.title} eyebrow="LinkedIn post"
  facts={[{ label: 'Published', value: fmtDate(p.data.date) }, ...(p.data.minutes ? [{ label: 'Reading time', value: `${p.data.minutes} min` }] : []), { label: 'First shared', value: `<a class="link" href="${profile.linkedin}">LinkedIn</a>` }]} description={p.data.dek} active="Writing" back={{ href: '/writing/', label: 'All writing' }}
  crumbs={[{ href: '/writing/', label: 'Writing' }, { label: p.data.title }]}>
  <p class="dek">{p.data.dek}</p>
  {p.data.cover && <p><img class="cover" src={p.data.cover} alt="" /></p>}
  <Content />
</Doc>)}

<style>
  .dek { font: 400 24px/1.35 var(--serif); color: var(--ink-2); margin: 0; }
  .cover { width: 100% !important; max-width: 520px; margin: 32px 0 8px !important; border-radius: 16px; }
</style>
