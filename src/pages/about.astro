---
import Base from '../layouts/Base.astro';
import { profile, experience, experienceLabel } from '../data/profile';
const exp = experienceLabel();
const principles = [
  ['Count before you design', 'Most of my studies started with a popular opinion that the evidence then overturned. Reading the reviews, the data and the research first is cheaper than building the wrong thing.'],
  ['Keep what already works', 'A redesign that removes the energy a product depends on, or slows down something people like, isn’t an improvement. I look for what to protect before I look for what to fix.'],
  ['Write the test that could prove me wrong', 'Every proposal comes with the five-person test and the production metric that would tell me it failed, before anyone builds it.'],
  ['Ship it properly', 'Architecture, performance, release pipelines and the people doing the work. A good idea is only worth what reaches the store.'],
];
const skills = [
  ['Research', 'Review mining and coding · competitive teardowns · user testing · experiment design'],
  ['Design', 'Flows and prototypes · interaction design · Figma · re-creating real app UI for testing'],
  ['Engineering', 'Flutter · Kotlin · Swift · Clean Architecture · BLoC · performance · CI/CD and store releases'],
  ['Leading', 'A 7-person cross-functional team · code review · sprint planning · mentoring'],
];
---
<Base title="About · Mitul Vaghasiya" active="About" description="Mitul Vaghasiya: product designer and researcher who also ships mobile apps. Surat, India.">
  <section class="wrap hero">
    <div class="who">
      <img src="/images/mitul-400.jpg" alt="Mitul Vaghasiya" width="64" height="64" />
      <p><b>Mitul Vaghasiya</b><span>Product designer &amp; researcher · {profile.location}</span></p>
    </div>
    <h1>I find out why people keep apps, and then I build them.</h1>
  </section>

  <section class="wrap row">
    <h2 class="label">Story</h2>
    <div class="content story">
      <p class="first">I started in November 2019 as a junior Flutter developer in Surat, and I’ve been building mobile apps ever since, {exp} now, for clients in Canada, Germany, Korea, Japan, Brazil and India. Today I lead the mobile team at KGK InfoTech.</p>
      <p>Somewhere along the way I noticed that the apps that failed were rarely badly built. They were well built for a problem people didn’t have. So I changed how I work: research first, validate with a prototype, then build and measure whether people actually stay.</p>
      <p>This site is where I do that in the open. I study apps millions of people use, publish what I find, and write about research, mobile UX and building products people keep.</p>
      <dl class="facts">
        <div><dt>Now</dt><dd>Mobile team lead, KGK InfoTech</dd></div>
        <div><dt>Building since</dt><dd>November 2019</dd></div>
        <div><dt>Based in</dt><dd>{profile.location}</dd></div>
        <div><dt>Elsewhere</dt><dd><a class="link" href={profile.linkedin}>LinkedIn</a>, <a class="link" href={profile.github}>GitHub</a></dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap row">
    <h2 class="label">How I work</h2>
    <div class="content principles">
      {principles.map(([t, d], i) => <div><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></div>)}
    </div>
  </section>

  <section class="wrap row">
    <h2 class="label">Experience</h2>
    <ol class="content list">
      {experience.map(e => <li><span class="when">{e.period}</span><div><h3>{e.company}</h3><p class="role">{e.role}</p><p>{e.note}</p></div></li>)}
    </ol>
  </section>

  <section class="wrap row">
    <h2 class="label">What I bring</h2>
    <dl class="content list skills">
      {skills.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </section>

  <section class="wrap row">
    <h2 class="label">Education</h2>
    <ol class="content list">
      <li><span class="when">2017 — 2020</span><div><h3>S.V. Patel College, Surat</h3><p class="role">Bachelor of Computer Applications</p></div></li>
    </ol>
  </section>
</Base>

<style>
  /* One grid for the whole page: a label column and a content column, on the same lines as the header */
  .hero { padding-top: 72px; padding-bottom: 72px; }
  .who { display: flex; align-items: center; gap: 16px; }
  .who img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
  .who p { margin: 0; display: flex; flex-direction: column; line-height: 1.35; }
  .who b { font-weight: 600; }
  .who span { color: var(--ink-3); font-size: 15px; }
  .hero h1 { font-size: var(--display); margin: 32px 0 0; max-width: var(--title); }
  .row { display: grid; grid-template-columns: 280px 1fr; gap: 48px; padding-top: 40px; padding-bottom: 72px; position: relative; }
  .row::before { content: ''; position: absolute; top: 0; left: 32px; right: 32px; border-top: 1px solid var(--line); }
  .label { font-size: clamp(28px, 2.6vw, 36px); }
  .content { margin: 0; padding: 0; max-width: var(--text); }
  .story p { font-size: 18px; color: var(--ink-2); }
  .story .first { font: 400 clamp(24px, 2.2vw, 30px)/1.35 var(--serif); color: var(--ink); }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; margin: 32px 0 0; font-size: 15px; }
  .facts div { padding: 12px 0; border-top: 1px solid var(--line); }
  .facts dt { color: var(--ink-3); font-size: 13px; }
  .facts dd { margin: 2px 0 0; }
  .principles { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 48px; }
  .n { font-size: 13px; color: var(--ink-3); }
  .principles h3 { font-size: 26px; margin: 8px 0 10px; }
  .principles p { color: var(--ink-2); font-size: 16px; margin: 0; }
  .list { list-style: none; }
  .list > li, .list > div { display: grid; grid-template-columns: 170px 1fr; gap: 24px; padding: 20px 0; border-top: 1px solid var(--line); }
  .list > :first-child { border-top: 0; padding-top: 4px; }
  .when { color: var(--ink-3); font-size: 15px; padding-top: 6px; }
  .list h3 { font-size: 26px; }
  .role { font-weight: 500; margin: 4px 0 6px; }
  .list p:last-child { color: var(--ink-2); margin: 0; }
  .list .role:last-child { color: var(--ink); }
  .skills dt { font: 400 24px/1.2 var(--serif); }
  .skills dd { margin: 0; color: var(--ink-2); padding-top: 3px; }
  @media (max-width: 960px) {
    .row { grid-template-columns: 1fr; gap: 24px; padding-bottom: 56px; }
  }
  @media (max-width: 760px) {
    .hero { padding-top: 40px; padding-bottom: 48px; }
    .row::before { left: 20px; right: 20px; }
    .principles, .facts { grid-template-columns: 1fr; }
    .list > li, .list > div { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
