---
// Before and after: two live phones side by side. Each phone is prototype/try.html?v=A|B&solo=1 in a frame.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import StudyTabs from '../../../components/StudyTabs.astro';
export async function getStaticPaths() {
  return (await getCollection('prototypes')).map(p => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data, c = d.compare;
const base = `/studies/${p.id}/`;
const sides = [
  { key: 'before', v: 'A', label: 'Before', sub: 'Today’s app, re-created', g: c.before },
  { key: 'after', v: 'B', label: 'After', sub: 'My proposal', g: c.after },
];
---
<Base title={`${d.app} before and after · Mitul Vaghasiya`} description={c.question.replace(/<[^>]+>/g, '')} active="Case studies"
  crumbs={[{ href: '/studies/', label: 'Case studies' }, { href: base, label: d.app }, { label: 'Try it' }]}>
  <StudyTabs slug={p.id} current="try" />
  <header class="wrap head">
    <p class="eyebrow">Before and after · {d.app}</p>
    <h1>{c.title}</h1>
    <p class="lede" set:html={c.question} />
  </header>

  <section class="wrap grid" data-controls={JSON.stringify(c.controls)}>
    {sides.map(s => (
      <div class="col">
        <p class:list={['pill', s.key]}><b>{s.label}</b> · {s.sub}</p>
        <div class="guide top">
          <p><b>Try:</b> <span set:html={s.g.try} /></p>
          <p><b>Notice:</b> <span set:html={s.g.notice} /></p>
        </div>
        <div class="fit"><iframe class="phone" data-side={s.key} src={`${base}prototype/try.html?v=${s.v}&solo=1`} title={`${s.label}: ${s.sub}`} width="390" height="844" /></div>
        <div class="actions">
          {c.controls.map((ct, i) => ct.side === s.key && <>
            <button class="btn small" data-side={s.key} data-i={i}>{ct.label}</button>
            {ct.status && <span class="status" id={`st-${s.key}-${ct.status}`} />}
          </>)}
          <button class="btn small ghost" data-restart={s.key}>Restart</button>
        </div>
      </div>
    ))}
  </section>

  <section class="wrap foot">
    <p class="disclaim">Both phones are live: tap through them. Both are my re-creations in {d.app}’s visual style, based on its App Store screenshots (10 Oct 2026) and the <a class="link" href={`${base}sources/`}>public images listed in the sources</a>. They are not the real app. Independent study, not affiliated with {d.app}; prices and numbers on screen are placeholders.</p>
    <div class="links">
      <a class="btn" href={`${base}prototype/`}>Screen by screen →</a>
      <a class="btn ghost" href={base}>Back to the study</a>
    </div>
  </section>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('.grid')!;
  const controls: { side: string; label: string; click: string; status?: string }[] = JSON.parse(grid.dataset.controls || '[]');
  const frame = (k: string) => document.querySelector<HTMLIFrameElement>(`.phone[data-side="${k}"]`)!;

  // Scale both phones to fit the column and the window, at the same scale
  const fit = () => {
    const tops = [...document.querySelectorAll<HTMLElement>('.guide.top')];
    tops.forEach(t => (t.style.minHeight = ''));
    if (innerWidth > 860) { const h = Math.max(...tops.map(t => t.offsetHeight)); tops.forEach(t => (t.style.minHeight = h + 'px')); }
    const col = document.querySelector<HTMLElement>('.col')!;
    const w = col.clientWidth - (innerWidth > 860 ? 56 : 32);
    const s = Math.min(1, w / 390, Math.max(.55, (innerHeight - 140) / 844));
    document.querySelectorAll<HTMLIFrameElement>('.phone').forEach(f => {
      f.style.transform = `scale(${s})`;
      const box = f.parentElement!; box.style.width = 390 * s + 'px'; box.style.height = 844 * s + 'px'; box.style.borderRadius = 54 * s + 'px';
    });
  };
  addEventListener('resize', fit); fit(); document.fonts.ready.then(fit);

  document.querySelectorAll<HTMLButtonElement>('[data-restart]').forEach(b => (b.onclick = () => { const f = frame(b.dataset.restart!); f.src = f.src; }));
  document.querySelectorAll<HTMLButtonElement>('button[data-i]').forEach(b => (b.onclick = () => {
    frame(b.dataset.side!).contentWindow!.postMessage({ click: controls[+b.dataset.i!].click }, '*');
  }));
  // Status labels (e.g. "Day 2") come back from the phone they belong to
  addEventListener('message', e => {
    controls.forEach(c => {
      if (!c.status || !e.data || e.data.status !== c.status || e.source !== frame(c.side).contentWindow) return;
      const el = document.getElementById(`st-${c.side}-${c.status}`); if (el) el.textContent = e.data.text;
    });
  });
</script>

<style>
  .head { padding-top: 56px; padding-bottom: 8px; max-width: 980px; margin-left: max(0px, calc((100vw - var(--wrap)) / 2)); }
  .head h1 { font-size: clamp(38px, 4.4vw, 58px); margin: 14px 0 20px; }
  .lede { font-size: 19px; color: var(--ink-2); max-width: 760px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 40px; }
  .col { background: var(--surface); border-radius: var(--radius); padding: 28px; display: flex; flex-direction: column; align-items: center; }
  .pill { align-self: flex-start; font: 400 13px/1 var(--sans); padding: 8px 12px; border-radius: 999px; margin: 0 0 18px; }
  .pill b { font-weight: 600; letter-spacing: .1em; text-transform: uppercase; font-size: 12px; }
  .pill.before { background: #f3e3dc; color: #8a3b1f; }
  .pill.after { background: var(--accent-soft); color: var(--accent); }
  .guide { align-self: stretch; font-size: 15px; color: var(--ink-2); margin-bottom: 20px; }
  .guide p { margin: 0 0 8px; }
  .guide b { color: var(--ink); font-weight: 600; }
  .fit { position: relative; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,.16); }
  .phone { border: 0; display: block; transform-origin: 0 0; background: transparent; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; margin-top: 22px; }
  .btn.small { height: 38px; padding: 0 16px; font-size: 14px; border: 0; cursor: pointer; }
  .btn.small.ghost { border: 1px solid var(--line); background: transparent; }
  .status { font-size: 14px; color: var(--ink-3); }
  .foot { padding-top: 24px; padding-bottom: 40px; }
  .disclaim { font-size: 13px; color: var(--ink-3); max-width: 820px; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .col { padding: 18px; } .head { padding-top: 32px; } }
</style>
