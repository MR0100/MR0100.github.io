---
import { getCollection, render } from 'astro:content';
import StudyDoc from '../../../layouts/StudyDoc.astro';
const LABELS: Record<string, string> = { 'test-kit': 'Test kit', sources: 'Sources' };
export async function getStaticPaths() {
  return (await getCollection('docs')).map(d => ({ params: { slug: d.data.study, doc: d.data.kind }, props: { d } }));
}
const { d } = Astro.props;
const { Content } = await render(d);
const label = LABELS[d.data.kind] ?? 'Review coding';
---
<StudyDoc slug={d.data.study} app={d.data.app} current={d.data.kind} label={label} title={d.data.title} words={(d.body ?? '').split(/\s+/).length}>
  <Content />
</StudyDoc>
