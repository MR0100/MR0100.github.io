---
import { getCollection, render } from 'astro:content';
import Doc from '../../../layouts/Doc.astro';
export async function getStaticPaths() {
  return (await getCollection('research')).map(r => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const { Content } = await render(r);
---
<Doc title={r.data.title} eyebrow={`Full analysis · ${r.data.app}`} back={{ href: `/studies/${r.id}/`, label: `${r.data.app} study` }}>
  <Content />
</Doc>
