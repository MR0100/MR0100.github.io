---
import { getCollection, render } from 'astro:content';
import StudyDoc from '../../../layouts/StudyDoc.astro';
export async function getStaticPaths() {
  return (await getCollection('research')).map(r => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const { Content } = await render(r);
---
<StudyDoc slug={r.id} app={r.data.app} current="full" label="Full analysis" title={r.data.title}>
  <Content />
</StudyDoc>
