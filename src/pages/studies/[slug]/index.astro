---
import { getCollection } from 'astro:content';
import StudyPage from '../../../components/StudyPage.astro';

export async function getStaticPaths() {
  const studies = (await getCollection('studies')).sort((a, b) => a.data.order - b.data.order);
  const docs = await getCollection('docs');
  return studies.map(s => ({
    params: { slug: s.id },
    props: { study: s, docs: docs.filter(d => d.data.study === s.id) },
  }));
}
const { study, docs } = Astro.props;
const d = study.data;
const base = `/studies/${study.id}/`;
const evidence = docs.filter(x => x.data.kind.startsWith('evidence/'));
const deeper = [
  { label: 'Try it', note: 'Before and after, both phones live', href: `${base}try/` },
  { label: 'The full analysis', note: 'Every source, table and decision', href: `${base}full/` },
  { label: 'Screen by screen', note: 'The flow, explained', href: `${base}prototype/` },
  { label: 'The user-test kit', note: 'Script, tasks and pass signals', href: `${base}test-kit/` },
  ...evidence.map(e => ({ label: 'The review coding', note: 'Every theme, with review ids', href: `${base}${e.data.kind}/` })),
  { label: 'Sources', note: 'What the screens were based on', href: `${base}sources/` },
];
---
<StudyPage study={study} active="Case studies" deeper={deeper}
  crumbs={[{ href: '/studies/', label: 'Case studies' }, { label: d.app }]} studyTabs={{ slug: study.id, current: 'overview' }} />
