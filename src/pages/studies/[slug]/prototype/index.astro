---
// Screen by screen: the flow as annotated screens, today vs the proposal (data synced from the research repo)
import { getCollection, getEntry } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import StudyTabs from '../../../../components/StudyTabs.astro';
import StudyPager from '../../../../components/StudyPager.astro';
import PageHead from '../../../../components/PageHead.astro';
import StudyProgress from '../../../../components/StudyProgress.astro';
export async function getStaticPaths() {
  return (await getCollection('prototypes')).map(p => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const study = (await getEntry('studies', p.id))!;
const accent = study.data.accent;
const base = `/studies/${p.id}/`;
const groups = [
  { key: 'today', eyebrow: 'Today', title: 'What happens now', sub: 'Re-created in the real app’s style. Where no public image of a state exists, it follows reviews and help pages, as noted in the study.', steps: d.today },
  { key: 'proposal', eyebrow: 'The proposal', title: 'What I’d build instead', sub: `The same moment, in ${d.proposal.length} screens.`, steps: d.proposal },
];
---
<Base title={`${d.app} screen by screen · Mitul Vaghasiya`} description={d.intro} active="Case studies" image={`${base}og.png`} type="article"
  crumbs={[{ href: '/studies/', label: 'Case studies' }, { href: base, label: d.app }, { label: 'Screen by screen' }]}>
  <StudyTabs slug={p.id} current="screens" />
  <PageHead eyebrow={`Screen by screen · ${d.app}`} title={d.title}
    facts={[{ label: 'Study', value: `<a class="link" href="${base}">${d.app}</a>` }, { label: 'This page', value: 'Screen by screen' }, { label: 'Screens', value: `${d.today.length} today · ${d.proposal.length} proposed` }]}>
    <StudyProgress slot="graphic" slug={p.id} current="screens" />
    <p class="lede">{d.intro}</p>
  </PageHead>

  {groups.map(g => (
    <section class="wrap group">
      <div class="ghead sec">
        <div class="side"><p class="eyebrow">{g.eyebrow}</p><h2>{g.title}</h2></div>
        <div class="main"><p class="sub">{g.sub}</p></div>
      </div>
      <div class:list={['steps', `n${g.steps.length}`]}>
        {g.steps.map((s, i) => (
          <figure>
            <div class="frame" style={`background:${accent}`}><img src={`${base}design/${s.image}`} alt={s.title} loading="lazy" /></div>
            <figcaption>
              <span class:list={['num', g.key]}>{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="principle">{s.principle}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap">
    <div class="learn">
      <div>
        <p class="eyebrow">What to take from this</p>
        <h2>Three lessons for any app</h2>
        <ol>{d.lessons.map(l => <li>{l}</li>)}</ol>
      </div>
      <div class="test">
        <p class="eyebrow">What the user test will decide</p>
        <p set:html={d.test} />
      </div>
    </div>
    <p class="disclaim in-main">{d.note} <a class="link" href={`${base}sources/`}>Sources</a>.</p>
  </section>
  <StudyPager slug={p.id} current="screens" />
</Base>

<style>
  .group { padding-top: 16px; padding-bottom: 24px; }
  .ghead { border-top: 1px solid var(--line); padding-top: 28px; margin-bottom: 32px; }
  .sub { color: var(--ink-2); font-size: 17px; margin: 0; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .steps.n2 { grid-template-columns: repeat(4, 1fr); }
  figure { margin: 0; }
  .frame { border-radius: 18px; padding: 24px 18px 0; display: flex; justify-content: center; overflow: hidden; aspect-ratio: 4 / 5; align-items: flex-start; }
  .frame img { width: 92%; }
  figcaption { margin-top: 16px; }
  .num { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; font: 600 13px/1 var(--sans); margin-bottom: 10px; }
  .num.today { background: #f3e3dc; color: #8a3b1f; }
  .num.proposal { background: var(--accent-soft); color: var(--accent); }
  h3 { font-size: 24px; margin: 0 0 8px; }
  figcaption p { color: var(--ink-2); font-size: 15px; margin: 0 0 10px; }
  .principle { font: 500 11px/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .learn { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; background: var(--surface); border-radius: var(--radius); padding: 36px; margin-top: 56px; }
  .learn h2 { font-size: clamp(28px, 2.6vw, 36px); margin: 10px 0 16px; }
  .learn ol { padding-left: 20px; margin: 0; color: var(--ink-2); }
  .learn li { margin-bottom: 8px; }
  .test { background: var(--accent-soft); border-radius: 14px; padding: 22px 24px; align-self: start; }
  .test p:last-child { margin: 8px 0 0; }
  .disclaim { font-size: 13px; color: var(--ink-3); margin-top: 24px; margin-bottom: 0; }
  @media (max-width: 960px) { .steps, .steps.n2 { grid-template-columns: 1fr 1fr; } .learn { grid-template-columns: 1fr; padding: 24px; } }
</style>
