---
// The KGK Diamonds case study, in the same template as the product studies (content: src/content/studies/kgk-diamonds.md)
import { getEntry } from 'astro:content';
import StudyPage from '../../../components/StudyPage.astro';
const study = (await getEntry('studies', 'kgk-diamonds'))!;
---
<StudyPage study={study} active="Work"
  crumbs={[{ href: '/work/', label: 'Work' }, { href: '/work/kgk-diamonds/', label: 'KGK Diamonds' }, { label: 'Case study' }]}
  tabs={[{ label: 'Project details', href: '/work/kgk-diamonds/' }, { label: 'Case study', href: '/work/kgk-diamonds/case-study/', current: true }]}
  next={{ href: '/studies/temu/', label: 'Temu: The games aren’t the problem. The hidden rules are.' }}
  deeper={[
    { label: 'Project details', note: 'The product, my role, the stack and more screens', href: '/work/kgk-diamonds/' },
    { label: 'App Store', note: 'The live app on iOS', href: 'https://apps.apple.com/in/app/kgk-diamonds-buy-diamonds/id6479595403', external: true },
    { label: 'Google Play', note: 'The live app on Android', href: 'https://play.google.com/store/apps/details?id=com.kgk.diamonds', external: true },
  ]} />
