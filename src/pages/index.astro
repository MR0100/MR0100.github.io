---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile, counts, testimonials, experienceLabel } from '../data/profile';
import { liveApps } from '../data/work';
import { publishedWriting, nextScheduled, fmtDate } from '../data/published';
const exp = experienceLabel();
const studies = (await getCollection('studies')).filter(s => s.data.kind !== 'client').sort((a, b) => a.data.order - b.data.order);
const [lead, ...rest] = studies;
const posts = (await publishedWriting()).slice(0, 3);
const upcoming = await nextScheduled();
const kgk = liveApps.find(a => a.slug === 'kgk-diamonds')!;
const others = liveApps.filter(a => a.icon && a.slug !== 'kgk-diamonds');
const quotes = import.meta.env.DEV ? testimonials : testimonials.filter(t => !t.placeholder);
---
<Base title="Mitul Vaghasiya · Product design, research and mobile">
  <section class="hero wrap">
    <div>
      <p class="eyebrow">{profile.role}</p>
      <h1>I study why people <em>keep</em> using apps, and design what makes them stay.</h1>
      <p class="lede">Case studies of products millions use, written analysis, and {exp} of shipping mobile apps. Research first, a prototype second, and a test that could prove me wrong.</p>
      <div class="actions"><a class="btn" href="/studies/">Read the case studies</a><a class="btn ghost" href="/about/">About me</a></div>
    </div>
    <figure class="portrait"><img src={profile.headshot} alt="Mitul Vaghasiya" width="440" height="440" /></figure>
  </section>

  <section class="wrap facts">
    <div><b>{studies.length}</b><span>product studies, each tested against real evidence</span></div>
    <div><b>8,000+</b><span>App Store reviews analysed for them</span></div>
    <div><b>Since 2019</b><span>building mobile apps, {liveApps.length} live in the stores</span></div>
  </section>

  <section class="section wrap" id="studies">
    <div class="section-head"><h2>Case studies</h2><a class="link" href="/studies/">All case studies →</a></div>
    <a class="feature" href={`/studies/${lead.id}/`}>
      <div class="fvis" style={`background:${lead.data.accent}`}>
        <img src={lead.data.heroImages[0]} alt="" /><img src={lead.data.heroImages[1]} alt="" />
      </div>
      <div class="ftext">
        <p class="eyebrow">{lead.data.app} · {lead.data.theme}</p>
        <h3>{lead.data.title}</h3>
        <p>{lead.data.summary}</p>
        <span class="more">Read the study →</span>
      </div>
    </a>
    <div class="cards">
      {rest.map(s => (
        <a class="card" href={`/studies/${s.id}/`}>
          <div class="cvis" style={`background:${s.data.accent}`}><img src={s.data.cover} alt="" loading="lazy" /></div>
          <p class="eyebrow">{s.data.app} · {s.data.theme}</p>
          <h3>{s.data.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap writing">
    <div class="section-head"><h2>Writing</h2><a class="link" href="/writing/">All writing →</a></div>
    {posts.length > 0 ? (
      <ol class="posts">
        {posts.map(p => <li><a href={`/writing/${p.id.replace(/^\d{4}-\d\d-\d\d-/, '')}/`}><time>{fmtDate(p.data.date)}</time><h3>{p.data.title}</h3><p>{p.data.dek}</p></a></li>)}
      </ol>
    ) : (
      <p class="soon">Short notes on research, mobile UX and building what people keep. The first one goes out on {upcoming ? fmtDate(upcoming.data.date) : 'soon'}.</p>
    )}
  </section>

  <section class="section wrap">
    <div class="section-head"><h2>Shipped work</h2><a class="link" href="/work/">All work →</a></div>
    <div class="work">
      <a class="kgk" href={`/work/${kgk.slug}/case-study/`}>
        <div class="kvis" style={`background:${kgk.accent}`}><img src={kgk.icon} alt="" width="104" height="104" /></div>
        <div>
          <p class="eyebrow">{kgk.client} · {kgk.role} · {kgk.period}</p>
          <h3>{kgk.name}</h3>
          <p>{kgk.oneLiner} Scrolling at 60 FPS on entry-level Android, releases in 1.5 days, 99.9% crash-free.</p>
          <span class="more">Read the case study →</span>
        </div>
      </a>
      <ul class="apps">
        {others.map(a => <li><img src={a.icon} alt="" width="48" height="48" /><div><b>{a.name}</b><span>{a.client}{a.rating && ` · ${a.rating}`}</span></div></li>)}
        <li class="all"><a class="link" href="/work/">{liveApps.length} live apps and {counts.projectsWorkedOn} projects →</a></li>
      </ul>
    </div>
  </section>

  {quotes.length > 0 && (
    <section class="section wrap">
      <div class="quotes">
        {quotes.map(t => (
          <figure class:list={['quote', { ph: t.placeholder }]}>
            <blockquote>“{t.quote}”</blockquote>
            <figcaption><b>{t.name}</b> · {t.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.45fr 1fr; gap: 64px; align-items: center; padding-top: 80px; padding-bottom: 64px; }
  .hero h1 { font-size: clamp(44px, 5.4vw, 78px); margin: 18px 0 26px; }
  .hero h1 em { font-style: italic; }
  .lede { font-size: 19px; color: var(--ink-2); max-width: 580px; }
  .actions { display: flex; gap: 12px; margin-top: 32px; flex-wrap: wrap; }
  .portrait { margin: 0; justify-self: end; width: 100%; max-width: 400px; }
  .portrait img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 28px; }

  .facts { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts div { padding: 28px 24px 28px 0; }
  .facts div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .facts b { display: block; font: 400 40px/1 var(--serif); }
  .facts span { display: block; margin-top: 10px; color: var(--ink-2); font-size: 15px; }

  .feature { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: center; margin-bottom: 40px; }
  .fvis { border-radius: var(--radius); height: 500px; display: flex; gap: 6%; justify-content: center; align-items: flex-end; padding-top: 40px; overflow: hidden; }
  .fvis img { width: 34%; filter: drop-shadow(0 20px 36px rgba(0,0,0,.12)); transition: transform .4s cubic-bezier(.2,.8,.2,1); }
  .feature:hover .fvis img { transform: translateY(-8px); }
  .ftext h3 { font-size: clamp(32px, 3.4vw, 48px); margin: 12px 0 16px; }
  .ftext p:not(.eyebrow) { color: var(--ink-2); }
  .more { font-weight: 500; font-size: 15px; }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .cvis { border-radius: 16px; aspect-ratio: 4/5; display: flex; justify-content: center; align-items: flex-end; padding-top: 20px; overflow: hidden; }
  .cvis img { width: 64%; transition: transform .4s; }
  .card:hover .cvis img { transform: translateY(-6px); }
  .card .eyebrow { margin: 16px 0 6px; }
  .card h3 { font-size: 23px; line-height: 1.2; }

  .posts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .posts a { display: block; border-top: 1px solid var(--ink); padding-top: 18px; }
  .posts time { font-size: 14px; color: var(--ink-3); }
  .posts h3 { font-size: 28px; margin: 8px 0 8px; }
  .posts p { color: var(--ink-2); margin: 0; font-size: 16px; }
  .soon { font: 400 26px/1.35 var(--serif); color: var(--ink-2); max-width: 760px; border-top: 1px solid var(--line); padding-top: 24px; margin: 0; }

  .work { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: start; }
  .kgk { display: grid; grid-template-columns: 200px 1fr; gap: 28px; align-items: center; }
  .kvis { border-radius: var(--radius); aspect-ratio: 1; display: grid; place-items: center; }
  .kvis img { border-radius: 24px; box-shadow: 0 16px 36px rgba(0,0,0,.14); }
  .kgk h3 { font-size: 34px; margin: 8px 0 10px; }
  .kgk p:not(.eyebrow) { color: var(--ink-2); }
  .apps { list-style: none; margin: 0; padding: 0; }
  .apps li { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .apps li:first-child { padding-top: 0; }
  .apps img { border-radius: 12px; }
  .apps b { display: block; font-weight: 600; font-size: 16px; }
  .apps span { font-size: 14px; color: var(--ink-3); }
  .apps .all { border-bottom: 0; font-size: 15px; }

  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .quote { margin: 0; padding: 8px 0 0; border-top: 1px solid var(--ink); }
  .quote blockquote { margin: 18px 0 16px; font: 400 clamp(26px, 2.6vw, 36px)/1.25 var(--serif); }
  .quote figcaption { font-size: 15px; color: var(--ink-3); }
  .quote figcaption b { color: var(--ink); font-weight: 600; }
  .quote.ph { border-top-style: dashed; border-top-color: var(--ink-3); }
  .quote.ph blockquote { color: var(--ink-3); font-size: 22px; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 32px; padding-top: 40px; }
    .portrait { justify-self: start; max-width: 300px; }
    .facts { grid-template-columns: 1fr; }
    .facts div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .feature { grid-template-columns: 1fr; gap: 24px; }
    .fvis { height: 360px; }
    .cards { grid-template-columns: 1fr 1fr; }
    .posts { grid-template-columns: 1fr; }
    .work { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .kgk { grid-template-columns: 1fr; } .kvis { max-width: 180px; } }
</style>
