---
import Base from '../layouts/Base.astro';
import { profile, counts, experience, testimonials, experienceLabel } from '../data/profile';
import { liveApps, studies, STORES_CHECKED } from '../data/work';
const exp = experienceLabel();
const featured = liveApps.slice(0, 3);
const shownTestimonials = import.meta.env.DEV || import.meta.env.SHOW_PLACEHOLDERS ? testimonials : testimonials.filter(t => !t.placeholder);
---
<Base title="Mitul Vaghasiya · Senior Mobile Engineer & Team Lead">
  <!-- Hero -->
  <section class="hero wrap">
    <div class="intro">
      <p class="eyebrow">{profile.role} · {profile.location}</p>
      <h1>I build mobile products people <em>keep</em>: researched first, shipped end to end.</h1>
      <p class="lede">I lead mobile at KGK InfoTech. Since 2019 I’ve built apps for clients in North America, Europe, Korea, Japan, Brazil and India, from the first user conversation to the store release.</p>
      <div class="actions"><a class="btn" href="/work/">See the work</a><a class="btn ghost" href="/resume/">Résumé</a></div>
    </div>
    <figure class="portrait"><img src={profile.headshot} alt="Mitul Vaghasiya" width="520" height="520" /></figure>
  </section>

  <!-- Proof strip -->
  <section class="wrap">
    <dl class="proof">
      <div><dt>Since 2019</dt><dd>building mobile apps, {exp}</dd></div>
      <div><dt>{counts.projectsWorkedOn}</dt><dd>projects, {liveApps.length} live in the stores today</dd></div>
      <div><dt>4.7★</dt><dd>from 2,086 ratings on MyTarot</dd></div>
      <div><dt>{counts.upworkJobSuccess}</dt><dd>Job Success on Upwork, {counts.upworkJobs} projects</dd></div>
    </dl>
  </section>

  <!-- Selected work -->
  <section class="section wrap" id="work">
    <div class="section-head"><h2>Selected work</h2><a class="link" href="/work/">All projects →</a></div>
    <div class="grid">
      {featured.map((a, i) => (
        <a class:list={['card', { wide: i === 0 }]} href={a.caseStudy ? `/work/${a.slug}/` : '/work/'}>
          <div class="panel" style={`background:${a.accent}`}>
            {a.icon && <img class="icon" src={a.icon} alt="" width="112" height="112" />}
            <span class="platforms">{a.platforms.join(' · ')}{a.rating && ` · ${a.rating}`}</span>
          </div>
          <div class="cap">
            <p class="eyebrow">{a.client} · {a.role} · {a.period}</p>
            <h3>{a.name}</h3>
            <p>{a.oneLiner}</p>
            {a.caseStudy && <span class="more">Read the case study →</span>}
          </div>
        </a>
      ))}
    </div>
    <p class="note">Store ratings checked {STORES_CHECKED}.</p>
  </section>

  <!-- Studies -->
  <section class="section wrap" id="studies">
    <div class="section-head">
      <h2>Product studies</h2>
      <p class="aside">Independent research into apps millions use: what users struggle with, what it costs the business, and a tested way to fix it.</p>
    </div>
    <div class="studies">
      {studies.map(s => (
        <a class="study" href={`/studies/${s.slug}/`}>
          <div class="thumb" style={`background:${s.accent}`}><img src={s.cover} alt="" loading="lazy" /></div>
          <p class="eyebrow">{s.app} · {s.theme}</p>
          <h3>{s.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="section wrap split">
    <div><h2 class="h2">Experience</h2><p class="aside">From junior Flutter developer in 2019 to leading a mobile team, with freelance work alongside.</p></div>
    <ol class="timeline">
      {experience.map(e => (
        <li><span class="when">{e.period}</span><div><h3>{e.company}</h3><p class="role">{e.role}</p><p>{e.note}</p></div></li>
      ))}
    </ol>
  </section>

  <!-- Testimonials -->
  <section class="section wrap">
    <div class="section-head"><h2>In their words</h2></div>
    <div class="quotes">
      {shownTestimonials.map(t => (
        <figure class:list={['quote', { ph: t.placeholder }]}>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption><b>{t.name}</b><span>{t.title}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.35fr 1fr; gap: 64px; align-items: center; padding-top: 72px; padding-bottom: 72px; }
  .hero h1 { font-size: clamp(44px, 5.4vw, 76px); margin: 18px 0 24px; }
  .hero h1 em { font-style: italic; }
  .lede { font-size: 19px; color: var(--ink-2); max-width: 560px; }
  .actions { display: flex; gap: 12px; margin-top: 32px; }
  .portrait { margin: 0; justify-self: end; width: 100%; max-width: 440px; }
  .portrait img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 28px; }

  .proof { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .proof div { padding: 28px 24px 28px 0; }
  .proof div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .proof dt { font: 400 40px/1 var(--serif); }
  .proof dd { margin: 10px 0 0; color: var(--ink-2); font-size: 15px; }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .card { display: block; }
  .card.wide { grid-column: 1 / -1; }
  .panel { position: relative; border-radius: var(--radius); height: 340px; display: grid; place-items: center; overflow: hidden; transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .card.wide .panel { height: 440px; }
  .card:hover .panel { transform: scale(.992); }
  .icon { width: 112px; height: 112px; border-radius: 26px; box-shadow: 0 18px 40px rgba(0,0,0,.14); }
  .card.wide .icon { width: 140px; height: 140px; border-radius: 32px; }
  .platforms { position: absolute; left: 24px; bottom: 20px; font-size: 13px; color: var(--ink-2); background: rgba(255,255,255,.7); padding: 6px 12px; border-radius: 999px; }
  .cap { padding: 22px 4px 0; max-width: 640px; }
  .cap h3 { font-size: 32px; margin: 8px 0 8px; }
  .cap p { color: var(--ink-2); margin: 0; }
  .more { display: inline-block; margin-top: 12px; font-weight: 500; font-size: 15px; }
  .note { font-size: 13px; color: var(--ink-3); margin-top: 24px; }

  .aside { color: var(--ink-2); max-width: 460px; margin: 0; }
  .studies { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .study .thumb { border-radius: 16px; aspect-ratio: 3/4; overflow: hidden; display: grid; place-items: end center; padding-top: 18px; }
  .study .thumb img { width: 76%; transition: transform .35s; }
  .study:hover .thumb img { transform: translateY(-6px); }
  .study .eyebrow { margin: 14px 0 6px; }
  .study h3 { font-size: 21px; line-height: 1.2; }

  .split { display: grid; grid-template-columns: 1fr 1.6fr; gap: 64px; }
  .h2 { font-size: clamp(34px, 3.4vw, 46px); margin-bottom: 14px; }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline li { display: grid; grid-template-columns: 170px 1fr; gap: 24px; padding: 26px 0; border-top: 1px solid var(--line); }
  .timeline li:last-child { border-bottom: 1px solid var(--line); }
  .when { color: var(--ink-3); font-size: 15px; padding-top: 6px; }
  .timeline h3 { font-size: 28px; }
  .role { font-weight: 500; margin: 4px 0 8px; }
  .timeline p:last-child { color: var(--ink-2); margin: 0; }

  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .quote { margin: 0; background: var(--surface); border-radius: var(--radius); padding: 32px; display: flex; flex-direction: column; justify-content: space-between; min-height: 240px; }
  .quote blockquote { margin: 0 0 24px; font: 400 25px/1.3 var(--serif); }
  .quote figcaption { display: flex; flex-direction: column; font-size: 14px; color: var(--ink-2); }
  .quote figcaption b { color: var(--ink); font-weight: 600; }
  .quote.ph { background: transparent; border: 1.5px dashed var(--line); color: var(--ink-3); }
  .quote.ph blockquote { font-size: 19px; color: var(--ink-3); }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; gap: 36px; padding-top: 40px; }
    .portrait { justify-self: start; max-width: 320px; }
    .proof { grid-template-columns: 1fr 1fr; }
    .proof div:nth-child(3) { border-left: 0; padding-left: 0; }
    .grid { grid-template-columns: 1fr; }
    .studies { grid-template-columns: repeat(2, 1fr); }
    .split { grid-template-columns: 1fr; gap: 24px; }
    .quotes { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .timeline li { grid-template-columns: 1fr; gap: 6px; }
    .panel, .card.wide .panel { height: 260px; }
  }
</style>
