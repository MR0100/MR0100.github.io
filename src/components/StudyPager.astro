---
// Back on the left, next on the right: the previous and next parts of the same study.
// The first part goes back to all studies; the last part goes on to the next study.
import { getCollection } from 'astro:content';
import Pager from './Pager.astro';
import { studyTabs } from '../data/studyNav';
interface Props { slug: string; current: string }
const { slug, current } = Astro.props;
const tabs = await studyTabs(slug);
const i = tabs.findIndex(t => t.key === current);
const studies = (await getCollection('studies')).sort((a, b) => a.data.order - b.data.order);
const after = studies[(studies.findIndex(s => s.id === slug) + 1) % studies.length];
const prev = tabs[i - 1] ?? { href: '/studies/', label: 'All case studies' };
const next = tabs[i + 1] ?? { href: `/studies/${after.id}/`, label: `Next study: ${after.data.app}` };
---
<Pager prev={prev} next={next} label="Study pages" />
