---
// A small graphic for the side column: the parts of one study as segments, the current one filled. Each segment links to its part.
import { studyTabs } from '../data/studyNav';
interface Props { slug: string; current: string }
const { slug, current } = Astro.props;
const tabs = await studyTabs(slug);
const i = tabs.findIndex(t => t.key === current);
---
<nav class="sprog" aria-label="Parts of this study">
  <ol>{tabs.map((t, k) => <li class:list={{ on: k === i, done: k < i }}><a href={t.href} title={t.label} aria-current={k === i ? 'page' : undefined}><span>{t.label}</span></a></li>)}</ol>
  <p>Part {i + 1} of {tabs.length} · {tabs[i]?.label}</p>
</nav>

<style>
  .sprog { margin-bottom: 20px; }
  ol { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  li { flex: 1; }
  a { display: block; height: 6px; border-radius: 3px; background: var(--line); transition: background .2s; }
  a span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .done a { background: #b9c2bb; }
  .on a { background: var(--accent); }
  a:hover { background: var(--ink-3); }
  p { margin: 10px 0 0; font-size: 13px; color: var(--ink-3); }
</style>
