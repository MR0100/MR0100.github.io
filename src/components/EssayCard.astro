---
// One essay as a card: cover, topic, title, dek and reading time.
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../data/published';
interface Props { p: CollectionEntry<'writing'>; big?: boolean }
const { p, big = false } = Astro.props;
const href = `/writing/${p.id.replace(/^\d{4}-\d\d-\d\d-/, '')}/`;
---
<a class:list={['ecard', { big }]} href={href}>
  {p.data.cover && <div class="img"><img src={p.data.cover} alt="" loading={big ? 'eager' : 'lazy'} /></div>}
  <div class="txt">
    <p class="eyebrow">{p.data.topic ?? 'Essay'} · {p.data.minutes} min read</p>
    <h3>{p.data.title}</h3>
    <p class="dek">{p.data.dek}</p>
    {big && <p class="date">{fmtDate(p.data.date)} · <span>Read the essay →</span></p>}
  </div>
</a>

<style>
  .ecard { display: flex; flex-direction: column; gap: 18px; }
  .img { border-radius: var(--radius); overflow: hidden; aspect-ratio: 16 / 9; background: var(--accent-soft); }
  .img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .ecard:hover .img img { transform: scale(1.03); }
  h3 { font-size: clamp(24px, 2.2vw, 30px); line-height: 1.12; margin: 8px 0 8px; }
  .ecard:hover h3 { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .dek { color: var(--ink-2); font-size: 16px; margin: 0; }
  .big { display: grid; grid-template-columns: 1.35fr 1fr; gap: 48px; align-items: center; }
  .big h3 { font-size: clamp(32px, 3.4vw, 46px); }
  .big .dek { font-size: 18px; }
  .date { margin: 18px 0 0; font-size: 14px; color: var(--ink-3); }
  .date span { color: var(--ink); font-weight: 500; }
  @media (max-width: 860px) { .big { grid-template-columns: 1fr; gap: 20px; } }
</style>
