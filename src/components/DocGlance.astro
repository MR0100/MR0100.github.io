---
// The "at a glance" band under a study document's opening, in the style of Overview, Try it and Screen by screen:
// big numbers, then the document's own visual (session timeline and signals, or theme counts), then its contents as a card.
import { docGlance } from '../lib/docGlance';
interface Props { kind: string; body?: string; headings?: { depth: number; slug: string; text: string }[] }
const { kind, body = '', headings = [] } = Astro.props;
const g = docGlance(kind, body);
const toc = headings.filter(h => h.depth === 2);
const max = Math.max(1, ...(g.bars?.rows.map(r => r.value) ?? [1]));
---
<section class="glance">
  {g.stats.length > 0 && <div class="stats">{g.stats.map(s => <div><b>{s.value}</b><span>{s.label}</span></div>)}</div>}

  {g.steps && g.steps.length > 0 && (
    <div class="card">
      <p class="eyebrow">The session, step by step</p>
      <ol class="steps">{g.steps.map((s, i) => <li style={`flex-grow:${s.minutes}`}><span class="n">{i + 1}</span><b>{s.name}</b><span class="t">{s.time}</span></li>)}</ol>
    </div>
  )}
  {g.signals && (g.signals.pass || g.signals.kill) && (
    <div class="signals">
      {g.signals.pass && <div class="pass"><p class="eyebrow">Pass signal</p><p>{g.signals.pass}</p></div>}
      {g.signals.kill && <div class="kill"><p class="eyebrow">Kill signal</p><p>{g.signals.kill}</p></div>}
    </div>
  )}
  {g.bars && g.bars.rows.length > 1 && (
    <div class="card">
      <p class="eyebrow">{g.bars.title}</p>
      <ul class="bars">{g.bars.rows.map(r => <li class:list={{ sub: r.sub }}><span class="l">{r.sub ? `of which: ${r.label}` : r.label}</span><span class="track"><i style={`width:${(r.value / max) * 100}%`} /></span><b>{r.value.toLocaleString('en-GB')}</b></li>)}</ul>
    </div>
  )}

  {toc.length > 1 && (
    <nav class="card toc" aria-label="On this page">
      <p class="eyebrow">On this page</p>
      <ol>{toc.map((h, i) => <li><a href={`#${h.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{h.text.replace(/^\d+\.\s*/, '')}</a></li>)}</ol>
    </nav>
  )}
</section>

<style>
  .glance { display: grid; gap: 24px; margin-top: 56px; }
  /* Big numbers, as on the overview */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .stats div { padding: 28px 24px 28px 0; }
  .stats div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .stats b { display: block; font: 400 clamp(36px, 3.6vw, 52px)/1 var(--serif); color: var(--ink); }
  .stats span { display: block; margin-top: 10px; color: var(--ink-2); font-size: 15px; }
  /* White cards, as on Try it and Screen by screen */
  .card { background: var(--surface); border-radius: var(--radius); padding: 28px 32px; }
  .card > .eyebrow { margin: 0 0 18px; }
  /* Test kit: the script as a timeline, each step as wide as its minutes */
  .steps { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .steps li { flex-basis: 0; min-width: 104px; background: var(--accent-soft); border-radius: 14px; padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 6px; }
  .steps .n { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--surface); font: 600 12px/1 var(--sans); color: var(--accent); }
  .steps b { font: 400 20px/1.15 var(--serif); color: var(--ink); }
  .steps .t { font-size: 13px; color: var(--ink-3); }
  .signals { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .signals > div { border-radius: var(--radius); padding: 24px 28px; }
  .signals .pass { background: var(--accent-soft); }
  .signals .kill { background: #f3e3dc; }
  .signals .eyebrow { margin: 0 0 10px; }
  .signals p:last-child { margin: 0; color: var(--ink); }
  /* Review coding: the counts as bars */
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .bars li { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) 56px; gap: 16px; align-items: center; font-size: 15px; }
  .bars .l { color: var(--ink-2); }
  .bars .track { height: 10px; border-radius: 5px; background: var(--accent-soft); overflow: hidden; }
  .bars i { display: block; height: 100%; border-radius: 5px; background: var(--accent); }
  .bars b { font-weight: 600; text-align: right; color: var(--ink); }
  .bars .sub .l { padding-left: 18px; color: var(--ink-3); font-size: 14px; }
  .bars .sub i { background: #8fa197; }
  .bars .sub b { font-weight: 500; color: var(--ink-3); }
  /* Contents, numbered like the steps on Screen by screen */
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 32px; }
  /* One rule above each item, level across the row; no document link underline (it doubled the lines) */
  .toc li { display: flex; }
  .toc a { flex: 1; display: flex; gap: 12px; padding: 12px 0; border: 0 !important; border-bottom: 1px solid var(--line) !important; font-size: 15px; color: var(--ink); }
  .toc li:nth-child(-n + 3) a { border-top: 1px solid var(--line) !important; }
  .toc a span { flex: none; color: var(--ink-3); font-size: 13px; padding-top: 2px; }
  .toc a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) {
    .stats { grid-auto-flow: row; grid-template-columns: 1fr 1fr; }
    .stats div + div { padding-left: 0; border-left: 0; }
    .stats div:nth-child(even) { padding-left: 20px; border-left: 1px solid var(--line); }
    .stats div:nth-child(n + 3) { border-top: 1px solid var(--line); }
    .steps { flex-direction: column; gap: 6px; }
    .steps li { flex-direction: row; align-items: center; gap: 12px; padding: 10px 14px; }
    .steps b { font-size: 18px; }
    .steps .t { margin-left: auto; white-space: nowrap; }
    .signals, .toc ol { grid-template-columns: 1fr; }
    .toc li:nth-child(-n + 3) a { border-top: 0 !important; }
    .toc li:first-child a { border-top: 1px solid var(--line) !important; }
    .bars li { grid-template-columns: minmax(0, 1fr) 48px; }
    .bars .track { grid-column: 1 / -1; grid-row: 2; }
    .card { padding: 22px 20px; }
  }
</style>
