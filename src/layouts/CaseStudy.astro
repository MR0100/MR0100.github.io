---
import Base from './Base.astro';
import StudyTabs from '../components/StudyTabs.astro';
import Tabs from '../components/Tabs.astro';
interface Meta { label: string; value: string }
interface Props { study?: { slug: string; current: string }; tabs?: { label: string; href: string; current?: boolean }[]; image?: string;
  title: string; app: string; summary: string; meta: Meta[]; accent: string; icon?: string;
  kind?: string; active?: string; crumbs?: { href?: string; label: string }[];
}
const { title, app, summary, meta, accent, icon, kind = 'Case study', active = 'Work', crumbs = [], study, tabs, image } = Astro.props;
---
<Base title={app === title ? `${app} · Mitul Vaghasiya` : `${app} · ${title} · Mitul Vaghasiya`} description={summary} active={active} crumbs={crumbs} image={image} type="article">
  {study && <StudyTabs {...study} />}
  {tabs && <Tabs items={tabs} />}
  <article>
    <header class="wrap page-head">
      <p class="eyebrow">{kind} · {app}</p>
      <h1>{title}</h1>
      <div class="sec facts">
        <dl class="side meta">
          {meta.map(m => <div><dt>{m.label}</dt><dd set:html={m.value} /></div>)}
        </dl>
        <div class="main"><p class="summary">{summary}</p></div>
      </div>
    </header>
    <div class="wrap">
      <div class="hero" style={`background:${accent}`}>
        <slot name="hero">{icon && <img src={icon} alt="" width="160" height="160" class="hero-icon" />}</slot>
      </div>
    </div>
    <div class="body"><slot /></div>
  </article>
  <slot name="pager" />
</Base>

<style>
  /* Header: title from the left edge; the facts in the side column, the summary in the main column */
  .facts { margin-top: 32px; }
  .summary { font-size: 19px; color: var(--ink-2); margin: 0; }
  .meta { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .meta div { display: grid; grid-template-columns: 110px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .meta dt { color: var(--ink-3); }
  .meta dd { margin: 0; }
  .hero { border-radius: var(--radius); min-height: 460px; display: grid; place-items: center; overflow: hidden; }
  .hero-icon { width: 160px; height: 160px; border-radius: 36px; box-shadow: 0 24px 60px rgba(0,0,0,.16); }
  .body { padding: 72px 0 24px; }
  /* Text sections are .sec grids (side heading, main text) across the full grid */
  .body :global(section) { max-width: var(--wrap); margin: 0 auto 72px; padding: 0 32px; }
  .body :global(section p), .body :global(section li) { color: var(--ink-2); }
  .body :global(section ul) { padding-left: 20px; margin: 0 0 1em; }
  .body :global(section li) { margin-bottom: 8px; }
  .body :global(section strong) { color: var(--ink); font-weight: 600; }
  .body :global(.wide) { max-width: var(--wrap); margin: 0 auto 72px; padding: 0 32px; }
  .body :global(.stats) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .body :global(.stats div) { padding: 32px 24px 32px 0; }
  .body :global(.stats div + div) { padding-left: 24px; border-left: 1px solid var(--line); }
  .body :global(.stats b) { display: block; font: 400 clamp(40px, 4vw, 56px)/1 var(--serif); color: var(--ink); }
  .body :global(.stats span) { display: block; margin-top: 10px; color: var(--ink-2); font-size: 15px; }
  .body :global(.tldr) { background: var(--surface); border-radius: var(--radius); padding: 32px 36px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .body :global(.tldr h3) { font: 600 13px/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 10px; }
  .body :global(.tldr p) { margin: 0; color: var(--ink); }
  .body :global(.visual) { border-radius: var(--radius); background: var(--accent-soft); min-height: 420px; display: grid; place-items: center; color: var(--ink-3); font-size: 14px; text-align: center; padding: 24px; }
  .body :global(.visual.pending) { border: 1.5px dashed #c9ccc5; background: transparent; }
  .body :global(.decision) { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .body :global(.decision > div) { background: var(--surface); border-radius: var(--radius); padding: 28px; }
  .body :global(.decision h3) { font-size: 24px; margin: 6px 0 10px; }
  .body :global(.decision p) { color: var(--ink-2); margin: 0; }
  @media (max-width: 900px) {
    .hero { min-height: 300px; }
    .body :global(.stats), .body :global(.tldr), .body :global(.decision) { grid-template-columns: 1fr; }
    .body :global(.stats div + div) { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .body :global(section), .body :global(.wide) { padding: 0 20px; }
  }
</style>
