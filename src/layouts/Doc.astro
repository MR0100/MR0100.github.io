---
import Base from './Base.astro';
import StudyTabs from '../components/StudyTabs.astro';
interface Crumb { href?: string; label: string }
interface Props { image?: string; study?: { slug: string; current: string }; title: string; eyebrow: string; back?: { href: string; label: string }; crumbs?: Crumb[]; description?: string; active?: string }
const { title, eyebrow, back, crumbs, description, active = 'Case studies', study, image } = Astro.props;
---
<Base title={`${title} · Mitul Vaghasiya`} description={description} active={active} image={image} type="article" crumbs={crumbs ?? (back ? [back, { label: title }] : [])}>
  {study && <StudyTabs {...study} />}
  <article class="doc wrap">
    <header>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <slot name="lede" />
    </header>
    <div class="prose"><slot /></div>
    {back && <p class="end"><a class="link" href={back.href}>← {back.label}</a></p>}
  </article>
</Base>

<style>
  .doc { padding-top: 48px; padding-bottom: 72px; }
  header { max-width: var(--text); margin: 0 auto 48px; }
  h1 { font-size: clamp(38px, 4.4vw, 58px); margin: 14px 0 0; }
  .end { max-width: var(--text); margin: 56px auto 0; font-size: 15px; }
</style>
