---
// The longer pages of a study (full analysis, test kit, review coding, sources), in the same layout as Try it and Screen by screen.
import Base from './Base.astro';
import StudyTabs from '../components/StudyTabs.astro';
import StudyPager from '../components/StudyPager.astro';
import Facts from '../components/Facts.astro';
import StudyProgress from '../components/StudyProgress.astro';
import { studyTabs } from '../data/studyNav';
import { getEntry } from 'astro:content';
interface Props { slug: string; app: string; current: string; label: string; title: string; description?: string; words?: number }
const { slug, app, current, label, title, description, words = 0 } = Astro.props;
const study = await getEntry('studies', slug);
const accent = study?.data.accent ?? '#e7ece6';
const facts = [
  { label: 'Study', value: `<a class="link" href="/studies/${slug}/">${app}</a>` },
  { label: 'This page', value: label },
  ...(words ? [{ label: 'Reading time', value: `${Math.max(1, Math.round(words / 230))} min` }] : []),
];
---
<Base title={`${app} · ${label} · Mitul Vaghasiya`} description={description} active="Case studies" image={`/studies/${slug}/og.png`} type="article"
  crumbs={[{ href: '/studies/', label: 'Case studies' }, { href: `/studies/${slug}/`, label: app }, { label }]}>
  <StudyTabs slug={slug} current={current} />
  <header class="wrap page-head">
    <p class="eyebrow">{label} · {app}</p>
    <h1>{title}</h1>
  </header>
  <div class="wrap"><div class="sdoc lead-grid" style={`--fig-bg:${accent}`}>
    <Facts class="lead-facts" items={facts}><StudyProgress slug={slug} current={current} /></Facts>
    <slot />
  </div></div>
  <StudyPager slug={slug} current={current} />
</Base>

<style>
  /* The body is laid out as .sec grids (rehype-sections): headings in the side column, text in the main column, tables and screens across both */
  .sdoc { padding-bottom: 24px; font-size: 17px; color: var(--ink-2); }

  .sdoc :global(p), .sdoc :global(ul), .sdoc :global(ol) { margin-top: 0; margin-bottom: 1em; }
  .sdoc :global(li) { margin-bottom: .45em; }
  .sdoc :global(ul ul), .sdoc :global(ol ul) { margin-top: .45em; }
  .sdoc :global(strong) { color: var(--ink); font-weight: 600; }
  .sdoc :global(a) { color: var(--ink); border-bottom: 1px solid #c9c7bf; overflow-wrap: anywhere; }
  .sdoc :global(a:hover) { border-color: var(--ink); }
  .sdoc :global(code) { font-size: .86em; background: var(--accent-soft); padding: 1px 6px; border-radius: 6px; }
  .sdoc :global(h3) { font-family: var(--sans); font-size: 18px; font-weight: 600; letter-spacing: 0; color: var(--ink); margin-top: 32px; margin-bottom: 10px; line-height: 1.4; }
  /* The disclaimer and summary at the top */
  .sdoc :global(.sec.intro > .main > blockquote:first-child) { margin-top: 0; margin-bottom: 24px; padding: 16px 20px; background: var(--surface); border-radius: 14px; border: 0; font: 400 15px/1.6 var(--sans); color: var(--ink-2); }
  .sdoc :global(.sec.intro > .main > blockquote:first-child + p) { font-size: 19px; color: var(--ink-2); }
  /* Quotes from reviews, as on the overview */
  .sdoc :global(blockquote) { margin: 24px 0; padding: 0 0 0 22px; border-left: 2px solid var(--accent); font: 400 23px/1.4 var(--serif); color: var(--ink); }
  .sdoc :global(blockquote p) { margin: 0; }
  .sdoc :global(hr) { display: none; }
  /* Tables as cards */
  .sdoc :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 15px; margin-top: 20px; margin-bottom: 28px; background: var(--surface); border-radius: 14px; padding: 6px 4px; }
  .sdoc :global(th), .sdoc :global(td) { text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .sdoc :global(th) { color: var(--ink-3); font-weight: 500; font-size: 13px; letter-spacing: .02em; }
  .sdoc :global(tr:last-child td) { border-bottom: 0; }
  /* Figures in tinted frames, laid out side by side */
  .sdoc :global(.figs) { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 28px; margin-top: 28px; margin-bottom: 36px; }
  .sdoc :global(figure.fig) { margin: 0; }
  .sdoc :global(.fig .frame) { background: var(--fig-bg); border-radius: 18px; padding: 24px 18px 0; display: flex; justify-content: center; overflow: hidden; }
  .sdoc :global(.fig .frame img) { width: 88%; display: block; }
  .sdoc :global(.fig figcaption) { font-size: 14px; color: var(--ink-2); margin-top: 14px; line-height: 1.55; }
  .sdoc :global(.note-box) { background: var(--accent-soft); color: var(--ink-2); font-size: 15px; border-radius: 12px; padding: 14px 18px; margin-top: 24px; margin-bottom: 8px; }
  .sdoc :global(.note-box + p em) { font-size: 14px; }
  @media (max-width: 760px) {
    .sdoc { font-size: 16px; }
    .sdoc :global(.figs) { grid-template-columns: 1fr 1fr; gap: 16px; }
    .sdoc :global(table) { display: block; overflow-x: auto; }
  }
</style>
